diff --git a/src/snapshot/deserializer.cc b/src/snapshot/deserializer.cc
index 09ddc385edb..f1f4ca6aa62 100644
--- a/src/snapshot/deserializer.cc
+++ b/src/snapshot/deserializer.cc
@@ -349,6 +349,29 @@ Deserializer<IsolateT>::Deserializer(IsolateT* isolate,
 template <typename IsolateT>
 void Deserializer<IsolateT>::Rehash() {
   DCHECK(should_rehash());
+
+  // Analysis-only compatibility mode.
+  //
+  // When deserializing code produced against a different read-only snapshot,
+  // hash-dependent objects can contain string hash / forwarding-table state
+  // that is only valid in the producer's snapshot. We have observed failures
+  // in both NameDictionary::Rehash() and DescriptorArray::Sort(), each ending
+  // in StringForwardingTable::GetRawHash().
+  //
+  // Keep should_rehash_ true so the normal user-code deserialization control
+  // flow and its invariants are preserved, but skip the actual queued rehash
+  // operations. This mode is only for static recovery/disassembly. The
+  // resulting heap must not be used for normal execution or hash-table lookup.
+  constexpr bool kSkipAllUserCodeRehashForAnalysis = true;
+
+  if (kSkipAllUserCodeRehashForAnalysis && deserializing_user_code()) {
+    PrintF(
+        "[!] WARNING: skipping %zu queued rehash operation(s) "
+        "(analysis-only mode)\n",
+        to_rehash_.size());
+    return;
+  }
+
   for (DirectHandle<HeapObject> item : to_rehash_) {
     item->RehashBasedOnMap(isolate());
   }
