diff --git a/src/objects/bytecode-array.cc b/src/objects/bytecode-array.cc
index 36f0a691db3..0c6222f53dc 100644
--- a/src/objects/bytecode-array.cc
+++ b/src/objects/bytecode-array.cc
@@ -5,10 +5,12 @@
 #include "src/objects/bytecode-array.h"
 
 #include <iomanip>
+#include <vector>
 
 #include "src/codegen/handler-table.h"
 #include "src/codegen/source-position-table.h"
 #include "src/common/globals.h"
+#include "src/heap/read-only-heap.h"
 #include "src/interpreter/bytecode-array-iterator.h"
 #include "src/interpreter/bytecode-decoder.h"
 #include "src/objects/bytecode-array-inl.h"
@@ -157,10 +159,99 @@ void BytecodeArray::Disassemble(Handle<BytecodeArray> handle,
     iterator.Advance();
   }
 
-  os << "Constant pool (size = " << handle->constant_pool()->length() << ")\n";
+  auto constant_pool = handle->constant_pool();
+  os << "Constant pool (size = " << constant_pool->length() << ")\n";
 #ifdef OBJECT_PRINT
-  if (handle->constant_pool()->length() > 0) {
-    Print(handle->constant_pool(), os);
+  // Analysis-only compatibility mode for caches produced against a different
+  // read-only snapshot.
+  //
+  // Do not probe the map/type of every non-RO constant. With a mismatched
+  // producer snapshot, some entries can be malformed from the point of view of
+  // this isolate, and even an IsString()/IsSharedFunctionInfo() test may
+  // dereference an unsafe map pointer.
+  //
+  // Instead, use bytecode semantics to decide which constant-pool entries are
+  // worth dereferencing:
+  //   * every cache-local String (after excluding read-only-space objects),
+  //   * CreateClosure operand 0, which is expected to be SharedFunctionInfo.
+  //
+  // Everything else stays opaque. This preserves recursive function discovery
+  // while recovering global/property names and ordinary literals.
+  std::vector<uint8_t> closure_entry(constant_pool->length(), 0);
+  std::vector<uint8_t> name_entry(constant_pool->length(), 0);
+
+  interpreter::BytecodeArrayIterator constant_ref_it(handle);
+  while (!constant_ref_it.done()) {
+    interpreter::Bytecode bytecode = constant_ref_it.current_bytecode();
+
+    if (bytecode == interpreter::Bytecode::kCreateClosure) {
+      int index = constant_ref_it.GetIndexOperand(0);
+      if (index >= 0 && index < constant_pool->length()) {
+        closure_entry[index] = 1;
+      }
+    } else if (bytecode == interpreter::Bytecode::kLdaGlobal ||
+               bytecode == interpreter::Bytecode::kLdaGlobalInsideTypeof ||
+               bytecode == interpreter::Bytecode::kStaGlobal ||
+               bytecode == interpreter::Bytecode::kThrowReferenceErrorIfHole) {
+      // These bytecodes carry a Name/String constant as operand 0.
+      int index = constant_ref_it.GetIndexOperand(0);
+      if (index >= 0 && index < constant_pool->length()) {
+        name_entry[index] = 1;
+      }
+    } else if (bytecode == interpreter::Bytecode::kGetNamedProperty ||
+               bytecode == interpreter::Bytecode::kGetNamedPropertyFromSuper ||
+               bytecode == interpreter::Bytecode::kSetNamedProperty ||
+               bytecode == interpreter::Bytecode::kDefineNamedOwnProperty) {
+      // Operand 0 is the receiver/register, operand 1 is the Name/String.
+      int index = constant_ref_it.GetIndexOperand(1);
+      if (index >= 0 && index < constant_pool->length()) {
+        name_entry[index] = 1;
+      }
+    }
+
+    constant_ref_it.Advance();
+  }
+
+  os << " - length: " << constant_pool->length() << "\n";
+  for (int i = 0; i < constant_pool->length(); ++i) {
+    Tagged<Object> object = constant_pool->get(i);
+    os << i << ": ";
+
+    if (IsSmi(object)) {
+      os << Smi::ToInt(object) << "\n";
+      continue;
+    }
+
+    Tagged<HeapObject> heap_object = Cast<HeapObject>(object);
+    if (ReadOnlyHeap::Contains(heap_object)) {
+      os << "ROConst_0x" << std::hex << object.ptr() << std::dec << "\n";
+      continue;
+    }
+
+    // If bytecode semantics guarantee that this slot is a Name/String, print it
+    // even if a generic IsString() probe is unreliable under the mismatched
+    // snapshot. Read-only objects were already filtered above, so this only
+    // applies to cache-local objects reconstructed by the code deserializer.
+    if (name_entry[i]) {
+      os << Brief(object) << "\n";
+      continue;
+    }
+
+    // Recover every other cache-local String normally.
+    if (IsString(object)) {
+      os << Brief(object) << "\n";
+      continue;
+    }
+
+    if (closure_entry[i]) {
+      // CreateClosure guarantees the semantic role of this pool entry. Avoid a
+      // generic IsSharedFunctionInfo() probe and let the existing short printer
+      // recursively emit the child SharedFunctionInfo.
+      os << Brief(object) << "\n";
+      continue;
+    }
+
+    os << "RawConst_0x" << std::hex << object.ptr() << std::dec << "\n";
   }
 #endif
 
diff --git a/src/objects/string.cc b/src/objects/string.cc
index ce6cb8bc13e..45ce0067ed1 100644
--- a/src/objects/string.cc
+++ b/src/objects/string.cc
@@ -630,10 +630,17 @@ void String::PrintUC16(StringStream* accumulator, int start, int end) {
       accumulator->Add("\\r");
     } else if (c == '\\') {
       accumulator->Add("\\\\");
-    } else if (!std::isprint(c)) {
+    } else if (c >= 0x20 && c <= 0x7e) {
+      // Print only ASCII characters directly. StringCharacterStream returns
+      // UTF-16 code units, while std::isprint() is defined only for EOF or
+      // values representable as unsigned char. Passing arbitrary uint16_t
+      // values to std::isprint() is undefined behavior and may garble
+      // non-ASCII disassembly output.
+      accumulator->Put(static_cast<char>(c));
+    } else if (c <= 0xff) {
       accumulator->Add("\\x%02x", c);
     } else {
-      accumulator->Put(static_cast<char>(c));
+      accumulator->Add("\\u%04x", c);
     }
   }
 }
