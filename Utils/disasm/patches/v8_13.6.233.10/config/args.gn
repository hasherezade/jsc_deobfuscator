dcheck_always_on = false
is_component_build = false
is_debug = false
target_cpu = "x64"

use_custom_libcxx = true

v8_monolithic = true
v8_static_library = true
v8_use_external_startup_data = false

# Needed by v8dasm.
v8_enable_disassembler = true
v8_enable_object_print = true

# Match Node v24.11.0.
v8_enable_pointer_compression = false
v8_enable_pointer_compression_shared_cage = false
v8_enable_31bit_smis_on_64bit_arch = false
v8_enable_external_code_space = false
v8_enable_sandbox = false

v8_wasm_random_fuzzers = false
v8_enable_fuzztest = false
v8_enable_extensible_ro_snapshot = false
v8_enable_gdbjit = false
v8_enable_javascript_promise_hooks = true
v8_promise_internal_field_count = 1
v8_use_siphash = true

# Already matching Node, but make them explicit.
v8_enable_short_builtin_calls = true
v8_enable_wasm_simd256_revec = true
v8_enable_webassembly = true
v8_enable_maglev = true

